{
  "name": "deckyeq",
  "version": "1.1.0",
  "description": "Live PipeWire equalizer and portable presets for Decky Loader",
  "author": "Rayek",
  "license": "BSD-3-Clause",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "rollup -c && node scripts/check-build.mjs",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "build:native": "python scripts/build_native.py",
    "package": "npm run build:native && node scripts/package.mjs",
    "test:backend": "python -W error -m unittest discover -s tests -p \"test_*.py\"",
    "test:frontend": "vitest run",
    "test": "python scripts/run_tests.py",
    "dev": "vite --host 127.0.0.1",
    "check": "npm run typecheck && npm run build:native && npm test && npm run test:frontend && npm run build && npm run package"
  },
  "devDependencies": {
    "@decky/api": "1.1.3",
    "@decky/ui": "4.12.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.1",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "magic-string": "^0.30.21",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rollup": "^4.0.0",
    "rollup-plugin-external-globals": "^0.13.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2",
    "vite": "^6.4.0",
    "vitest": "^4.1.12"
  },
  "decky": {
    "files": [
      "main.py",
      "dk_*.py",
      "deckyeq",
      "bin/deckyeq_dsp.so",
      "presets",
      "schemas",
      "plugin.json",
      "package.json",
      "package-lock.json",
      "README.md",
      "CHANGELOG.md",
      "LICENSE",
      "NOTICE",
      "dist",
      "src",
      "native",
      "scripts",
      "rollup.config.js",
      "tsconfig.json",
      "docs/USAGE.md",
      "docs/VALIDATION.md",
      "docs/GO_S_PRESET.md"
    ],
    "forbidden": [
      "(^|/)preview(/|$)"
    ],
    "folder": "DeckyEQ",
    "python": ["3.14"],
    "flags": []
  }
}
