{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeckyEQ preset exchange version 2",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "format",
        "version",
        "preset"
      ],
      "properties": {
        "format": {
          "const": "deckyeq-preset"
        },
        "version": {
          "const": 2
        },
        "preset": {
          "$ref": "#/$defs/preset"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "format",
        "version",
        "presets"
      ],
      "properties": {
        "format": {
          "const": "deckyeq-bank"
        },
        "version": {
          "const": 2
        },
        "presets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/preset"
          }
        }
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "preset": {
      "type": "object",
      "required": [
        "name",
        "eq"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "eq": {
          "$ref": "#/$defs/eq"
        }
      }
    },
    "eq": {
      "type": "object",
      "required": [
        "bands",
        "bass",
        "treble",
        "preamp",
        "auto_headroom"
      ],
      "additionalProperties": false,
      "properties": {
        "bands": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": [
              "frequency",
              "gain",
              "q",
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "frequency": {
                "type": "number",
                "minimum": 0,
                "maximum": 48000
              },
              "gain": {
                "type": "number",
                "minimum": -12,
                "maximum": 12
              },
              "q": {
                "type": "number",
                "minimum": 0.2,
                "maximum": 5
              },
              "type": {
                "enum": [
                  "peaking",
                  "lowshelf",
                  "highshelf"
                ]
              }
            }
          }
        },
        "bass": {
          "type": "number",
          "minimum": -9,
          "maximum": 9
        },
        "treble": {
          "type": "number",
          "minimum": -9,
          "maximum": 9
        },
        "preamp": {
          "type": "number",
          "minimum": -36,
          "maximum": 12
        },
        "auto_headroom": {
          "type": "boolean"
        },
        "width": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "Stereo width: 0 is mono, 1 unchanged, 2 twice the side signal. Optional, default 1."
        },
        "limiter": {
          "type": "boolean",
          "description": "Look-ahead peak limiter. Optional, default true."
        }
      }
    }
  }
}
